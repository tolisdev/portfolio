---
import { ShieldCheck, X } from 'lucide-astro';

interface Props {
  gaId?: string;
}

const { gaId = "" } = Astro.props;
const cleanGaId = gaId ? gaId.trim() : "";
---

{cleanGaId && (
  <>
    <!-- Inline Default Consent Initialization (Strict GDPR Compliance) -->
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;

      // Set default consent to DENIED before any analytics loads
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'anonymize_ip': true
      });

      const savedConsent = localStorage.getItem('portfolio-cookie-consent');
      if (savedConsent === 'granted') {
        gtag('consent', 'update', {
          'analytics_storage': 'granted'
        });
        loadGA4Script("${cleanGaId}");
      }

      function loadGA4Script(id) {
        if (!id || document.getElementById('ga4-script')) return;
        const script = document.createElement('script');
        script.id = 'ga4-script';
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(script);

        gtag('js', new Date());
        gtag('config', id, { 'anonymize_ip': true });
      }
      window.loadGA4Script = loadGA4Script;
    `} />

    <!-- Non-Intrusive GDPR Cookie Banner -->
    <div
      id="cookie-banner"
      class="fixed bottom-5 left-5 right-5 sm:left-auto sm:right-5 sm:max-w-md z-50 hidden p-4 sm:p-5 rounded-2xl bg-theme-base border border-theme-strong shadow-2xl space-y-3 backdrop-blur-md animate-in fade-in slide-in-from-bottom-5 duration-300"
      role="dialog"
      aria-labelledby="cookie-banner-title"
    >
      <div class="flex items-start justify-between gap-3 border-b border-theme-subtle pb-2.5">
        <div class="flex items-center gap-2">
          <ShieldCheck class="w-4 h-4 text-pink-500 shrink-0" />
          <h2 id="cookie-banner-title" class="text-xs font-bold text-theme-primary">
            Privacy & Cookie Preferences
          </h2>
        </div>
        <button
          id="cookie-close-btn"
          type="button"
          aria-label="Dismiss cookie notice"
          class="text-theme-muted hover:text-theme-primary transition-colors cursor-pointer"
        >
          <X class="w-3.5 h-3.5" />
        </button>
      </div>

      <p class="text-[11px] sm:text-xs text-theme-muted leading-relaxed">
        This site uses optional Google Analytics to measure visitor traffic with IP anonymization. No personal data is tracked unless you consent.
      </p>

      <div class="flex items-center justify-end gap-2 pt-1">
        <button
          id="cookie-decline-btn"
          type="button"
          class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-theme-surface text-theme-muted border border-theme-subtle hover:text-theme-primary transition-all cursor-pointer"
        >
          Decline
        </button>
        <button
          id="cookie-accept-btn"
          type="button"
          class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-pink-600 hover:bg-pink-500 text-white shadow-xs transition-all cursor-pointer"
        >
          Accept Analytics
        </button>
      </div>
    </div>

    <script is:inline set:html={`
      function setupCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('cookie-accept-btn');
        const declineBtn = document.getElementById('cookie-decline-btn');
        const closeBtn = document.getElementById('cookie-close-btn');
        const gaId = "${cleanGaId}";

        if (!banner) return;

        function showBanner() {
          banner.classList.remove('hidden');
        }

        function hideBanner() {
          banner.classList.add('hidden');
        }

        const consent = localStorage.getItem('portfolio-cookie-consent');
        if (!consent) {
          setTimeout(showBanner, 400);
        }

        acceptBtn?.addEventListener('click', () => {
          localStorage.setItem('portfolio-cookie-consent', 'granted');
          if (window.gtag) {
            window.gtag('consent', 'update', {
              'analytics_storage': 'granted'
            });
          }
          if (window.loadGA4Script) {
            window.loadGA4Script(gaId);
          }
          hideBanner();
        });

        declineBtn?.addEventListener('click', () => {
          localStorage.setItem('portfolio-cookie-consent', 'denied');
          hideBanner();
        });

        closeBtn?.addEventListener('click', () => {
          hideBanner();
        });

        window.addEventListener('open-cookie-banner', showBanner);
      }

      setupCookieBanner();
      document.addEventListener('astro:page-load', setupCookieBanner);
    `} />
  </>
)}
