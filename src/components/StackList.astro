---
import { Cpu, Terminal, Layers, Server } from 'lucide-astro';

interface StackCategory {
  name?: string;
  skills?: readonly (string | null)[];
}

interface Props {
  stackData?: {
    categories?: readonly StackCategory[];
  } | null;
}

const { stackData } = Astro.props;

const defaultCategories = [
  {
    name: "Languages & Runtimes",
    skills: ["TypeScript", "Rust", "Go", "Node.js", "Python", "WebAssembly"]
  },
  {
    name: "Frameworks & Frontend",
    skills: ["Astro", "React", "Next.js", "Tailwind CSS", "Vite", "GraphQL"]
  },
  {
    name: "Systems & Infrastructure",
    skills: ["PostgreSQL", "Redis", "Docker", "Linux / POSIX", "Edge Workers"]
  }
];

const categories = (stackData?.categories && stackData.categories.length > 0)
  ? stackData.categories
  : defaultCategories;

const getIconForCategory = (index: number) => {
  if (index === 0) return Terminal;
  if (index === 1) return Layers;
  return Server;
};
---

<section class="space-y-4">
  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-theme-dim">
    <Cpu class="w-4 h-4 text-theme-accent" />
    <h2>Tech Stack</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
    {categories.map((cat, idx) => {
      const Icon = getIconForCategory(idx);
      const skills = cat.skills || [];

      return (
        <div class="p-4 rounded-xl bg-theme-surface border border-theme-subtle hover:border-theme-strong hover:shadow-xs hover:shadow-pink-500/5 backdrop-blur-sm transition-all duration-300 space-y-3">
          <div class="flex items-center gap-2 text-xs font-semibold text-theme-primary border-b border-theme-subtle pb-2">
            <Icon class="w-3.5 h-3.5 text-theme-accent" />
            <span>{cat.name}</span>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {skills.map((skill) => (
              skill && (
                <span class="inline-flex items-center px-2.5 py-1 text-xs font-mono font-medium rounded-md bg-theme-badge text-theme-secondary border border-theme-subtle hover:border-pink-500/40 hover:text-pink-300 hover:scale-105 hover:-translate-y-0.5 transition-all duration-200 cursor-default">
                  {skill}
                </span>
              )
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>
