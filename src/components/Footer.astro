---
import { ShieldCheck, Accessibility, Lock } from 'lucide-astro';

interface CustomLink {
  label?: string;
  url?: string;
}

interface FooterData {
  copyrightName?: string;
  note?: string;
  showAdminLink?: boolean;
  customLinks?: CustomLink[];
}

interface Props {
  name?: string;
  footer?: FooterData;
}

const { name = "Apostolos Katsoudas", footer } = Astro.props;
const currentYear = new Date().getFullYear();

const copyrightOwner = footer?.copyrightName || name;
const noteText = footer?.note || "Built with Astro & Keystatic";
const showAdmin = footer?.showAdminLink ?? true;
const customLinks = footer?.customLinks || [];
---

<footer class="mt-20 pt-8 pb-12 border-t border-theme-subtle text-xs text-theme-muted font-sans space-y-4">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
    <!-- Copyright & Note -->
    <div class="space-y-1">
      <div class="font-medium text-theme-primary">
        © {currentYear} {copyrightOwner}. All rights reserved.
      </div>
      {noteText && (
        <div class="text-[11px] text-theme-dim font-mono">
          {noteText}
        </div>
      )}
    </div>

    <!-- Navigation Links -->
    <div class="flex items-center justify-center md:justify-end flex-wrap gap-x-4 gap-y-2 text-theme-muted font-medium">
      <a
        href="/cookie-policy"
        class="inline-flex items-center gap-1.5 hover:text-pink-500 transition-colors focus-visible:outline-none"
      >
        <ShieldCheck class="w-3.5 h-3.5 text-pink-500 opacity-80" />
        <span>Privacy & Cookies</span>
      </a>

      <span class="text-theme-subtle hidden sm:inline">•</span>

      <a
        href="/accessibility-policy"
        class="inline-flex items-center gap-1.5 hover:text-pink-500 transition-colors focus-visible:outline-none"
      >
        <Accessibility class="w-3.5 h-3.5 text-pink-500 opacity-80" />
        <span>Accessibility</span>
      </a>

      {customLinks.map((link) => (
        link.label && link.url ? (
          <>
            <span class="text-theme-subtle hidden sm:inline">•</span>
            <a
              href={link.url}
              target={link.url.startsWith('http') ? "_blank" : "_self"}
              rel={link.url.startsWith('http') ? "noopener noreferrer" : ""}
              class="hover:text-pink-500 transition-colors focus-visible:outline-none"
            >
              {link.label}
            </a>
          </>
        ) : null
      ))}

      {showAdmin && (
        <>
          <span class="text-theme-subtle hidden sm:inline">•</span>
          <a
            href="/keystatic"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-theme-badge text-[11px] font-mono text-theme-secondary border border-theme-subtle hover:border-pink-500/40 hover:text-pink-400 transition-all focus-visible:outline-none"
          >
            <Lock class="w-3 h-3 text-pink-500" />
            <span>Admin</span>
          </a>
        </>
      )}
    </div>
  </div>
</footer>
