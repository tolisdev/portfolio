---
import { Send, Mail, Copy, Check, Phone } from 'lucide-astro';

interface Props {
  email?: string;
  phone?: string;
  phoneText?: string;
  github?: string;
  twitter?: string;
}

const {
  email = "contact@apostolosk.com",
  phone = "",
  phoneText = "",
  github = "https://github.com",
  twitter = "",
} = Astro.props;

const displayPhone = phoneText || phone;
// Preserve dialable characters: digits, +, commas (pause), semicolons (wait), p/w for extension pauses
const callTarget = phone
  ? phone.replace(/[^0-9+,;pwPW]/g, '')
  : displayPhone.replace(/[^0-9+,;pwPW]/g, '');
---

<section class="space-y-4">
  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-theme-dim">
    <Send class="w-4 h-4 text-theme-accent" />
    <h2>Contact</h2>
  </div>

  <div class="relative overflow-hidden p-6 sm:p-7 rounded-2xl bg-theme-surface border border-theme-subtle space-y-5 backdrop-blur-sm shadow-xs">
    <div class="space-y-1.5 max-w-lg">
      <h3 class="text-xl font-bold text-theme-primary font-sans tracking-tight">
        Let's build something together.
      </h3>
      <p class="text-xs sm:text-sm text-theme-muted leading-relaxed">
        Whether you have a technical architecture challenge, an open-source collaboration idea, or an advisory role, feel free to reach out.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-1">
      <!-- Direct Email Action -->
      {email && (
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-xl bg-pink-600 hover:bg-pink-500 text-white transition-all duration-200 shadow-sm hover:shadow-md cursor-pointer focus-visible:outline-none"
        >
          <Mail class="w-4 h-4" />
          <span>Send Email</span>
        </a>
      )}

      <!-- Work Phone Action (Preserves dial pause commas, semicolons & extensions) -->
      {displayPhone && (
        <a
          href={`tel:${callTarget}`}
          title={`Call ${displayPhone}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-medium rounded-xl bg-theme-badge text-theme-primary border border-theme-subtle hover:border-theme-strong hover:bg-theme-surface-hover transition-all duration-200 cursor-pointer focus-visible:outline-none"
        >
          <Phone class="w-4 h-4 text-pink-500" />
          <span>{displayPhone}</span>
        </a>
      )}

      <!-- Copy Email Button -->
      {email && (
        <button
          id="copy-email-btn"
          data-email={email}
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-medium rounded-xl bg-theme-badge text-theme-primary border border-theme-subtle hover:border-theme-strong hover:bg-theme-surface-hover transition-all duration-200 cursor-pointer focus-visible:outline-none"
        >
          <Copy id="copy-icon" class="w-4 h-4 text-theme-muted" />
          <Check id="check-icon" class="w-4 h-4 hidden text-pink-500" />
          <span id="copy-text">{email}</span>
        </button>
      )}
    </div>
  </div>
</section>

<script>
  function setupCopyEmail() {
    const copyBtn = document.getElementById('copy-email-btn');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || '';
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const copyIcon = document.getElementById('copy-icon');
        const checkIcon = document.getElementById('check-icon');
        const copyText = document.getElementById('copy-text');

        if (copyIcon && checkIcon && copyText) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          copyText.textContent = 'Copied to clipboard!';

          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            copyText.textContent = email;
          }, 2200);
        }
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }

  setupCopyEmail();
  document.addEventListener('astro:page-load', setupCopyEmail);
</script>
