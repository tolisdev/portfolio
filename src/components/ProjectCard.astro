---
import { ArrowUpRight } from 'lucide-astro';

interface ProjectItem {
  slug: string;
  entry: {
    title: string;
    description: string;
    coverImage?: string;
    link?: string;
    tags?: readonly (string | null)[];
    tag?: string;
  };
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const { title, description, coverImage, link, tags, tag } = project.entry;

// Combine tags array or fallback single tag string
const tagsList: string[] = (tags && tags.length > 0)
  ? (tags.filter((t): t is string => typeof t === 'string' && t.trim().length > 0) as string[])
  : (tag ? [tag] : []);

const searchText = `${title} ${description} ${tagsList.join(' ')}`.toLowerCase();
const tagAttribute = tagsList.join(' ').toLowerCase();
---

<a
  href={link || "#"}
  target="_blank"
  rel="noopener noreferrer"
  data-search-item
  data-tag={tagAttribute}
  data-text={searchText}
  class="project-card group relative block p-4 sm:p-5 rounded-xl bg-theme-surface border border-theme-subtle hover:border-theme-strong hover:bg-theme-card-hover hover:-translate-y-0.5 backdrop-blur-sm transition-all duration-300 overflow-hidden shadow-xs hover:shadow-md focus-visible:outline-none"
>
  <div class="flex flex-col sm:flex-row gap-4 items-start">
    {coverImage && (
      <div class="relative w-full sm:w-32 h-28 rounded-lg overflow-hidden shrink-0 bg-theme-badge border border-theme-subtle">
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
          onerror="this.style.display='none'"
        />
      </div>
    )}

    <div class="flex-1 min-w-0 space-y-2">
      <div class="flex items-center justify-between gap-2 flex-wrap">
        <h3 class="text-sm sm:text-base font-semibold text-theme-primary group-hover:text-theme-accent transition-colors flex items-center gap-1.5 font-sans">
          <span>{title}</span>
          <ArrowUpRight class="w-4 h-4 text-theme-dim group-hover:text-theme-accent opacity-60 group-hover:opacity-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-all duration-200" />
        </h3>

        {tagsList.length > 0 && (
          <div class="flex items-center gap-1 flex-wrap">
            {tagsList.map((t) => (
              <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-mono font-medium rounded-full bg-theme-badge text-theme-secondary border border-theme-subtle">
                {t}
              </span>
            ))}
          </div>
        )}
      </div>

      <p class="text-xs sm:text-sm text-theme-muted line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</a>
