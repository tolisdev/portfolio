---
import { FileText, ArrowRight } from 'lucide-astro';

interface PostItem {
  slug: string;
  entry: {
    title: string;
    publishedDate?: string;
    summary?: string;
  };
}

interface Props {
  posts: PostItem[];
}

const { posts = [] } = Astro.props;

// Sort by date descending
const sorted = [...posts].sort((a, b) => {
  const dateA = a.entry.publishedDate ? new Date(a.entry.publishedDate).getTime() : 0;
  const dateB = b.entry.publishedDate ? new Date(b.entry.publishedDate).getTime() : 0;
  return dateB - dateA;
});
---

<section class="space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-theme-dim">
      <FileText class="w-4 h-4 text-theme-accent" />
      <h2>Writing</h2>
    </div>
  </div>

  <div class="space-y-2.5">
    {sorted.map(({ slug, entry }) => {
      const formattedDate = entry.publishedDate
        ? new Date(entry.publishedDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })
        : '';

      const searchText = `${entry.title} ${entry.summary || ''}`.toLowerCase();

      return (
        <a
          href={`/posts/${slug}`}
          data-search-item
          data-text={searchText}
          class="group flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3.5 rounded-xl bg-theme-surface border border-theme-subtle hover:border-theme-strong hover:bg-theme-card-hover backdrop-blur-sm transition-all duration-300 shadow-xs hover:shadow-md focus-visible:outline-none"
        >
          <div class="space-y-1 min-w-0 pr-2">
            <h3 class="text-sm sm:text-base font-semibold text-theme-primary group-hover:text-theme-accent transition-colors font-sans truncate">
              {entry.title}
            </h3>
            {entry.summary && (
              <p class="text-xs text-theme-muted line-clamp-1 leading-relaxed">
                {entry.summary}
              </p>
            )}
          </div>

          <div class="flex items-center gap-2 text-xs text-theme-dim font-mono shrink-0 pt-1 sm:pt-0">
            <span>{formattedDate}</span>
            <ArrowRight class="w-4 h-4 text-theme-dim group-hover:text-theme-accent group-hover:translate-x-1 transition-all" />
          </div>
        </a>
      );
    })}
  </div>
</section>
