---
import { FileText, ArrowRight } from 'lucide-astro';

interface PostItem {
  slug: string;
  entry: {
    title: string;
    publishedDate?: string;
    summary?: string;
  };
}

interface Props {
  posts: PostItem[];
}

const { posts = [] } = Astro.props;

// Sort by date descending
const sorted = [...posts].sort((a, b) => {
  const dateA = a.entry.publishedDate ? new Date(a.entry.publishedDate).getTime() : 0;
  const dateB = b.entry.publishedDate ? new Date(b.entry.publishedDate).getTime() : 0;
  return dateB - dateA;
});
---

<section class="space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-500">
      <FileText class="w-3.5 h-3.5" />
      <h2>Writing</h2>
    </div>
  </div>

  <div class="space-y-1">
    {sorted.map(({ slug, entry }) => {
      const formattedDate = entry.publishedDate
        ? new Date(entry.publishedDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })
        : '';

      const searchText = `${entry.title} ${entry.summary || ''}`.toLowerCase();

      return (
        <a
          href={`/posts/${slug}`}
          data-search-item
          data-text={searchText}
          class="group flex items-baseline justify-between p-3 -mx-3 rounded-lg hover:bg-neutral-900/50 transition-colors duration-200"
        >
          <div class="space-y-1 min-w-0 pr-4">
            <h3 class="text-sm font-medium text-neutral-200 group-hover:text-white transition-colors truncate">
              {entry.title}
            </h3>
            {entry.summary && (
              <p class="text-xs text-neutral-500 line-clamp-1">
                {entry.summary}
              </p>
            )}
          </div>

          <div class="flex items-center gap-2 text-xs text-neutral-500 font-mono shrink-0">
            <span>{formattedDate}</span>
            <ArrowRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-neutral-400" />
          </div>
        </a>
      );
    })}
  </div>
</section>
