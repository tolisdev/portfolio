---
import { Search, X } from 'lucide-astro';

interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

<div class="space-y-3">
  <div class="relative flex items-center">
    <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-theme-dim pointer-events-none" />
    <input
      type="text"
      id="search-input"
      placeholder="Search projects, skills, or posts..."
      class="w-full pl-10 pr-9 py-2 text-xs sm:text-sm bg-theme-surface border border-theme-subtle rounded-xl text-theme-primary placeholder:text-theme-dim focus:outline-none focus:border-pink-500 transition-all shadow-xs"
    />
    <button
      id="clear-search-btn"
      class="absolute right-2.5 top-1/2 -translate-y-1/2 text-theme-dim hover:text-theme-primary hidden p-1 rounded-md transition-colors"
      aria-label="Clear search"
    >
      <X class="w-3.5 h-3.5" />
    </button>
  </div>

  <div class="flex items-center justify-between gap-2 flex-wrap">
    {tags.length > 0 && (
      <div class="flex items-center gap-1.5 flex-wrap">
        <button
          data-tag-filter="all"
          class="tag-filter-btn px-3 py-1 text-[11px] font-mono rounded-lg font-semibold bg-pink-500/15 text-pink-600 dark:text-pink-300 border border-pink-500/30 transition-all cursor-pointer"
        >
          All
        </button>
        {tags.map((tag) => (
          <button
            data-tag-filter={tag ? String(tag).toLowerCase() : ''}
            class="tag-filter-btn px-3 py-1 text-[11px] font-mono rounded-lg bg-theme-surface text-theme-muted border border-theme-subtle hover:border-theme-strong hover:text-theme-primary transition-all cursor-pointer"
          >
            {tag}
          </button>
        ))}
      </div>
    )}

    <span id="search-counter" class="text-xs font-mono text-theme-dim hidden">
      <!-- Dynamic result count -->
    </span>
  </div>
</div>

<script>
  function setupSearchFilter() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search-btn');
    const filterBtns = document.querySelectorAll('.tag-filter-btn');
    const items = document.querySelectorAll('[data-search-item]');
    const counter = document.getElementById('search-counter');

    if (!input) return;

    let activeTag = 'all';

    function filterItems() {
      const query = input.value.trim().toLowerCase();
      if (query.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      let visibleCount = 0;

      items.forEach((item) => {
        const text = item.getAttribute('data-text') || '';
        const itemTag = item.getAttribute('data-tag') || '';

        const matchesQuery = query === '' || text.includes(query);
        const matchesTag = activeTag === 'all' || itemTag.includes(activeTag);

        if (matchesQuery && matchesTag) {
          (item as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (counter) {
        if (query.length > 0 || activeTag !== 'all') {
          counter.textContent = `${visibleCount} item${visibleCount === 1 ? '' : 's'} found`;
          counter.classList.remove('hidden');
        } else {
          counter.classList.add('hidden');
        }
      }
    }

    input.addEventListener('input', filterItems);

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filterItems();
    });

    const activeClasses = ['bg-pink-500/15', 'text-pink-600', 'dark:text-pink-300', 'border-pink-500/30', 'font-semibold'];
    const inactiveClasses = ['bg-theme-surface', 'text-theme-muted', 'border-theme-subtle'];

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove(...activeClasses);
          b.classList.add(...inactiveClasses);
        });

        btn.classList.remove(...inactiveClasses);
        btn.classList.add(...activeClasses);

        activeTag = btn.getAttribute('data-tag-filter') || 'all';
        filterItems();
      });
    });
  }

  setupSearchFilter();
  document.addEventListener('astro:page-load', setupSearchFilter);
</script>
