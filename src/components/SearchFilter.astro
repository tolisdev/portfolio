---
import { Search, X } from 'lucide-astro';

interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

<div class="space-y-3 pb-2">
  <div class="relative">
    <Search class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-neutral-500" />
    <input
      type="text"
      id="search-input"
      placeholder="Search projects and posts..."
      class="w-full pl-9 pr-8 py-1.5 text-xs bg-neutral-900/60 border border-neutral-800 rounded-lg text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-neutral-700 transition-colors"
    />
    <button
      id="clear-search-btn"
      class="absolute right-2.5 top-1/2 -translate-y-1/2 text-neutral-500 hover:text-neutral-300 hidden p-1"
      aria-label="Clear search"
    >
      <X class="w-3 h-3" />
    </button>
  </div>

  {tags.length > 0 && (
    <div class="flex items-center gap-1.5 flex-wrap">
      <button
        data-tag-filter="all"
        class="tag-filter-btn px-2.5 py-1 text-[11px] font-mono rounded-md bg-neutral-850 text-neutral-100 border border-neutral-700 transition-colors"
      >
        All
      </button>
      {tags.map((tag) => (
        <button
          data-tag-filter={tag.toLowerCase()}
          class="tag-filter-btn px-2.5 py-1 text-[11px] font-mono rounded-md bg-neutral-900/80 text-neutral-400 border border-neutral-800 hover:border-neutral-700 hover:text-neutral-200 transition-colors"
        >
          {tag}
        </button>
      ))}
    </div>
  )}
</div>

<script>
  function setupSearchFilter() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-search-btn');
    const filterBtns = document.querySelectorAll('.tag-filter-btn');
    const items = document.querySelectorAll('[data-search-item]');

    if (!input) return;

    let activeTag = 'all';

    function filterItems() {
      const query = input.value.trim().toLowerCase();
      if (query.length > 0) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      items.forEach((item) => {
        const text = item.getAttribute('data-text') || '';
        const itemTag = item.getAttribute('data-tag') || '';

        const matchesQuery = query === '' || text.includes(query);
        const matchesTag = activeTag === 'all' || itemTag.includes(activeTag);

        if (matchesQuery && matchesTag) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    }

    input.addEventListener('input', filterItems);

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      filterItems();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-neutral-850', 'text-neutral-100', 'border-neutral-700');
          b.classList.add('bg-neutral-900/80', 'text-neutral-400', 'border-neutral-800');
        });

        btn.classList.remove('bg-neutral-900/80', 'text-neutral-400', 'border-neutral-800');
        btn.classList.add('bg-neutral-850', 'text-neutral-100', 'border-neutral-700');

        activeTag = btn.getAttribute('data-tag-filter') || 'all';
        filterItems();
      });
    });
  }

  setupSearchFilter();
  document.addEventListener('astro:page-load', setupSearchFilter);
</script>
