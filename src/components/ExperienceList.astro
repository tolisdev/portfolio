---
import { Briefcase } from 'lucide-astro';

interface ExperienceItem {
  slug: string;
  entry: {
    roleTitle: string;
    company: string;
    dateRange: string;
    order: number;
  };
}

interface Props {
  experiences: ExperienceItem[];
}

const { experiences = [] } = Astro.props;

// Sort by order ascending
const sorted = [...experiences].sort((a, b) => (a.entry.order || 99) - (b.entry.order || 99));
---

<section class="space-y-4">
  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-theme-dim">
    <Briefcase class="w-4 h-4 text-theme-accent" />
    <h2>Experience</h2>
  </div>

  <div class="relative pl-3 space-y-3 before:absolute before:left-[19px] before:top-3 before:bottom-3 before:w-[2px] before:bg-theme-subtle">
    {sorted.map(({ entry }) => (
      <div class="relative group flex items-start justify-between gap-4 p-3.5 rounded-xl bg-theme-surface border border-theme-subtle hover:border-theme-strong hover:bg-theme-card-hover backdrop-blur-sm transition-all duration-300 shadow-xs">
        <div class="flex items-start gap-3 min-w-0">
          <span class="relative z-10 flex h-3 w-3 mt-1 shrink-0 items-center justify-center rounded-full bg-theme-base border-2 border-pink-500 group-hover:scale-125 transition-transform"></span>
          <div class="space-y-1 min-w-0">
            <h3 class="text-sm font-semibold text-theme-primary group-hover:text-theme-accent transition-colors font-sans">
              {entry.roleTitle}
            </h3>
            <p class="text-xs text-theme-secondary font-medium">
              {entry.company}
            </p>
          </div>
        </div>
        <div class="text-xs text-theme-dim font-mono shrink-0 pt-0.5">
          {entry.dateRange}
        </div>
      </div>
    ))}
  </div>
</section>
