---
import { Palette } from 'lucide-astro';
---

<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-neutral-900/80 border border-neutral-800/80 backdrop-blur-sm text-xs">
  <Palette class="w-3 h-3 text-neutral-400" />
  <div class="flex items-center gap-1.5">
    <button
      data-theme="emerald"
      title="Emerald Accent"
      aria-label="Emerald Accent"
      class="w-3 h-3 rounded-full bg-emerald-500 hover:scale-125 transition-transform"
    ></button>
    <button
      data-theme="cyan"
      title="Cyan Accent"
      aria-label="Cyan Accent"
      class="w-3 h-3 rounded-full bg-cyan-500 hover:scale-125 transition-transform"
    ></button>
    <button
      data-theme="violet"
      title="Violet Accent"
      aria-label="Violet Accent"
      class="w-3 h-3 rounded-full bg-violet-500 hover:scale-125 transition-transform"
    ></button>
  </div>
</div>

<script>
  function setupThemePicker() {
    const saved = localStorage.getItem('portfolio-accent') || 'emerald';
    document.documentElement.setAttribute('data-accent', saved);

    const buttons = document.querySelectorAll('[data-theme]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme') || 'emerald';
        document.documentElement.setAttribute('data-accent', theme);
        localStorage.setItem('portfolio-accent', theme);
      });
    });
  }

  setupThemePicker();
  document.addEventListener('astro:page-load', setupThemePicker);
</script>
