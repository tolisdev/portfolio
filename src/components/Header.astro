---
import { Github, Twitter, Linkedin, Mail, Briefcase, GraduationCap } from 'lucide-astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: {
    name?: string;
    role?: string;
    roleSecondary?: string;
    location?: string;
    avatar?: string;
    bio?: string;
    socials?: {
      github?: string;
      twitter?: string;
      linkedin?: string;
      email?: string;
    };
  };
}

const { profile } = Astro.props;
const name = profile?.name || "Alex Vance";
const role = profile?.role || "Senior Full-Stack Engineer";
const roleSecondary = profile?.roleSecondary || "";
const location = profile?.location || "San Francisco, CA • Available for projects";
const avatar = profile?.avatar || "/images/profile/avatar.png";
const socials = profile?.socials || {};
---

<header class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div class="relative group">
      <div class="absolute -inset-1 bg-gradient-to-r from-pink-500/30 to-purple-500/30 rounded-full blur-md opacity-40 group-hover:opacity-80 transition duration-500"></div>
      <img
        src={avatar}
        alt={name}
        class="relative w-16 h-16 sm:w-18 sm:h-18 rounded-full object-cover border border-theme-strong bg-theme-badge shadow-sm"
        onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=alex'"
      />
    </div>

    <!-- Status badge & Light/Dark Theme Toggle -->
    <div class="flex items-center gap-3 flex-wrap">
      <ThemeToggle />
      <div class="inline-flex items-center gap-2 px-3 py-1.5 text-xs rounded-full bg-theme-surface border border-theme-subtle text-theme-secondary backdrop-blur-md shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
        </span>
        <span class="font-medium">{location}</span>
      </div>
    </div>
  </div>

  <div class="space-y-2">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-theme-primary font-sans">
      {name}
    </h1>

    <div class="space-y-1.5 pt-0.5">
      {role && (
        <div class="text-base sm:text-lg text-theme-accent font-medium flex items-center gap-2.5">
          <Briefcase class="w-4 h-4 text-pink-500 shrink-0" />
          <span>{role}</span>
        </div>
      )}
      {roleSecondary && (
        <div class="text-base sm:text-lg text-theme-accent font-medium flex items-center gap-2.5">
          <GraduationCap class="w-4 h-4 text-pink-500 shrink-0" />
          <span>{roleSecondary}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Bio section -->
  <div class="text-theme-muted leading-relaxed text-sm sm:text-base space-y-3 max-w-2xl">
    <slot name="bio">
      <p>
        Building ultra-fast, minimal digital experiences and backend services. Focused on high-performance web architecture, sleek developer tooling, and clean UI engineering.
      </p>
    </slot>
  </div>

  <!-- Social Icons -->
  <div class="flex items-center gap-3 pt-2 text-theme-muted">
    {socials.github && (
      <a
        href={socials.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="p-2.5 rounded-lg hover:text-theme-primary hover:bg-theme-surface transition-all duration-200 focus-visible:outline-none"
      >
        <Github class="w-5 h-5" />
      </a>
    )}
    {socials.twitter && (
      <a
        href={socials.twitter}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Twitter / X"
        class="p-2.5 rounded-lg hover:text-theme-primary hover:bg-theme-surface transition-all duration-200 focus-visible:outline-none"
      >
        <Twitter class="w-5 h-5" />
      </a>
    )}
    {socials.linkedin && (
      <a
        href={socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="p-2.5 rounded-lg hover:text-theme-primary hover:bg-theme-surface transition-all duration-200 focus-visible:outline-none"
      >
        <Linkedin class="w-5 h-5" />
      </a>
    )}
    {socials.email && (
      <a
        href={`mailto:${socials.email}`}
        aria-label="Email"
        class="p-2.5 rounded-lg hover:text-theme-primary hover:bg-theme-surface transition-all duration-200 focus-visible:outline-none"
      >
        <Mail class="w-5 h-5" />
      </a>
    )}
  </div>
</header>
