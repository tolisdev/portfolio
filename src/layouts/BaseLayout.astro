---
import '../styles/global.css';
import ParticlesBackground from '../components/ParticlesBackground.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Apostolos Katsoudas — Fullstack Developer",
  description = "Minimalist developer portfolio and personal website by Apostolos Katsoudas.",
  image = "/images/profile/avatar.jpg",
  type = "website",
  publishedDate,
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://apostolosk.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const safeImage = (typeof image === 'string' && image.trim().length > 0) ? image : "/images/profile/avatar.jpg";
const ogImageUrl = safeImage.startsWith('http') ? safeImage : new URL(safeImage, siteUrl).href;
const schemasToRender = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0914" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Apostolos Katsoudas Portfolio" />
    <meta property="og:locale" content="en_US" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Apostolos Katsoudas Blog RSS Feed" href="/sitemap-index.xml" />

    <!-- Fonts & Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- JSON-LD Structured Data -->
    {schemasToRender.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}
    <slot name="head" />

    <!-- Theme & Accessibility Initialization (Prevents FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('portfolio-theme')) {
          return localStorage.getItem('portfolio-theme');
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      }

      // Accessibility settings load
      try {
        const a11y = JSON.parse(localStorage.getItem('portfolio-a11y') || '{}');
        const html = document.documentElement;
        if (a11y.font === 'lg') html.classList.add('a11y-font-lg');
        if (a11y.font === 'xl') html.classList.add('a11y-font-xl');
        if (a11y.contrast) html.classList.add('a11y-high-contrast');
        if (a11y.dyslexic) html.classList.add('a11y-dyslexic');
        if (a11y.motion) html.classList.add('a11y-reduce-motion');
        if (a11y.links) html.classList.add('a11y-highlight-links');
      } catch (e) {}
    </script>
  </head>
  <body class="bg-theme-base text-theme-muted selection:bg-pink-500/20 selection:text-pink-300 min-h-screen font-sans antialiased relative">
    <Preloader />
    <ParticlesBackground />
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 md:px-8 py-10 md:py-16 min-h-screen flex flex-col justify-between">
      <main class="space-y-14 md:space-y-16">
        <slot />
      </main>
    </div>
    <AccessibilityWidget />
  </body>
</html>
