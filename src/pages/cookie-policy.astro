---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Document from '../components/Document';
import { ArrowLeft, ShieldCheck, Calendar } from 'lucide-astro';

const reader = createReader(process.cwd(), keystaticConfig);
let policyData: any = null;
let profile: any = null;

try {
  policyData = await reader.singletons.cookiePolicy.read();
  profile = await reader.singletons.profile.read();
} catch (e) {
  console.error("Error reading Cookie Policy:", e);
}

const contentDoc = policyData?.content ? await policyData.content() : null;
const title = policyData?.title || "Cookie & Privacy Policy";
const lastUpdated = policyData?.lastUpdated || "August 2026";
const pageTitle = `${title} — ${profile?.name || 'Apostolos Katsoudas'}`;
---

<BaseLayout
  title={pageTitle}
  description="Cookie and Privacy Policy detailing data handling, local storage, and optional Google Analytics consent."
  googleAnalyticsId={profile?.googleAnalyticsId}
>
  <article class="space-y-8">
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-theme-secondary hover:text-theme-primary bg-theme-surface border border-theme-subtle hover:border-theme-strong rounded-lg transition-all duration-200 group shadow-xs focus-visible:outline-none"
      >
        <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform text-theme-accent" />
        <span>Back to home</span>
      </a>
    </div>

    <header class="space-y-4 pb-8 border-b border-theme-subtle">
      <div class="flex items-center gap-2 text-xs font-mono text-theme-dim">
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-theme-badge border border-theme-subtle text-theme-secondary">
          <ShieldCheck class="w-3.5 h-3.5 text-pink-500" />
          <span>Privacy Document</span>
        </div>
        {lastUpdated && (
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-theme-badge border border-theme-subtle text-theme-muted">
            <Calendar class="w-3.5 h-3.5" />
            <span>Updated: {lastUpdated}</span>
          </div>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-theme-primary font-sans leading-tight">
        {title}
      </h1>
    </header>

    <main class="prose-dark max-w-none">
      {contentDoc ? (
        <Document document={contentDoc} client:load />
      ) : (
        <p>Policy content is being updated.</p>
      )}
    </main>
  </article>

  <Footer name={profile?.name || "Apostolos Katsoudas"} footer={profile?.footer} />
</BaseLayout>
