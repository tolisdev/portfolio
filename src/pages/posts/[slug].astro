---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Document from '../../components/Document';
import { ArrowLeft, Calendar, Clock } from 'lucide-astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const posts = await reader.collections.posts.all();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const reader = createReader(process.cwd(), keystaticConfig);
const post = await reader.collections.posts.read(slug);
const profile = await reader.singletons.profile.read();

if (!post) {
  return Astro.redirect('/404');
}

const content = await post.content();
const readingTime = getReadingTime(content);

const formattedDate = post.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<BaseLayout title={`${post.title} — ${profile?.name || 'Blog'}`}>
  <article class="space-y-8">
    <!-- Navigation Back Button -->
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-theme-secondary hover:text-theme-primary bg-theme-surface border border-theme-subtle hover:border-theme-strong rounded-lg transition-all duration-200 group shadow-xs focus-visible:outline-none"
      >
        <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform text-theme-accent" />
        <span>Back to home</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-theme-subtle">
      <div class="flex items-center gap-3 text-xs font-mono text-theme-dim flex-wrap">
        {formattedDate && (
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-theme-badge border border-theme-subtle text-theme-secondary">
            <Calendar class="w-3.5 h-3.5 text-theme-accent" />
            <time datetime={post.publishedDate}>{formattedDate}</time>
          </div>
        )}
        {readingTime && (
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-theme-badge border border-theme-subtle text-theme-secondary">
            <Clock class="w-3.5 h-3.5 text-theme-accent" />
            <span>{readingTime}</span>
          </div>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-theme-primary font-sans leading-tight">
        {post.title}
      </h1>

      {post.summary && (
        <p class="text-base sm:text-lg text-theme-muted font-normal leading-relaxed max-w-2xl">
          {post.summary}
        </p>
      )}
    </header>

    <!-- Post Document Content -->
    <main class="prose-dark max-w-none">
      <Document document={content} client:load />
    </main>

    <!-- Article Footer / Author signature -->
    <footer class="pt-8 border-t border-theme-subtle flex items-center justify-between text-xs text-theme-dim">
      <div>
        Written by <span class="text-theme-primary font-medium">{profile?.name || "Apostolos Katsoudas"}</span>
      </div>
      <a href="/" class="hover:text-theme-primary transition-colors focus-visible:outline-none">
        ← All articles
      </a>
    </footer>
  </article>

  <Footer name={profile?.name || "Apostolos Katsoudas"} footer={profile?.footer} />
</BaseLayout>
