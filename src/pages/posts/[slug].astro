---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Document from '../../components/Document';
import { ArrowLeft, Calendar } from 'lucide-astro';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const reader = createReader(process.cwd(), keystaticConfig);
const post = await reader.collections.posts.read(slug);
const profile = await reader.singletons.profile.read();

if (!post) {
  return Astro.redirect('/404');
}

const content = await post.content();
const formattedDate = post.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<BaseLayout title={`${post.title} — ${profile?.name || 'Blog'}`}>
  <article class="space-y-8">
    <!-- Navigation Back Button -->
    <div>
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-neutral-400 hover:text-white transition-colors duration-200 group"
      >
        <ArrowLeft class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" />
        <span>Back to home</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-3 pb-6 border-b border-neutral-900">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-500">
        <Calendar class="w-3.5 h-3.5" />
        <time datetime={post.publishedDate}>{formattedDate}</time>
      </div>

      <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-neutral-100 font-sans leading-tight">
        {post.title}
      </h1>

      {post.summary && (
        <p class="text-base text-neutral-400 font-normal leading-relaxed">
          {post.summary}
        </p>
      )}
    </header>

    <!-- Post Document Content -->
    <main>
      <Document document={content} client:load />
    </main>

    <!-- Article Footer / Author signature -->
    <footer class="pt-8 border-t border-neutral-900 flex items-center justify-between text-xs text-neutral-500">
      <div>
        Written by <span class="text-neutral-300 font-medium">{profile?.name || "Alex Vance"}</span>
      </div>
      <a href="/" class="hover:text-neutral-300 transition-colors">
        ← All articles
      </a>
    </footer>
  </article>

  <Footer name={profile?.name || "Alex Vance"} />
</BaseLayout>
